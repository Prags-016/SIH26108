# Server
PORT=8000
NODE_ENV=development

# MongoDB. The default local database is created on first seed.
MONGODB_URI=mongodb://127.0.0.1:27017/is_standards_engine

# Comma-separated browser origins. Credentials are allowed.
# 5173 is the handoff origin. 3000 is the Vite port used by this portal.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Every request is cut off at this budget (milliseconds). Do not raise it past 30000.
REQUEST_TIMEOUT_MS=30000

# Returned verbatim by GET /api/v1/health
DATA_LAST_SYNCED=2026-09-25

# Recommendation endpoints only.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60
